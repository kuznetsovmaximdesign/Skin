# Скопировать в backup.env, заполнить, chmod 600.

# Что копируем
DB_PATH=/opt/life-bot/var/life_bot.db
LOCAL_DIR=/opt/life-bot/var/backups

# Пароль шифрования. Файл с правами 600, одна строка.
# Потеряешь — копии превратятся в мусор. Храни отдельно от сервера.
PASSPHRASE_FILE=/opt/life-bot/deploy/backup.pass

# Куда увозим. Пусто — копия остаётся только локально, что бэкапом не является.
REMOTE=root@109.120.155.205:/root/life-bot-backups
SSH_KEY=/home/lifebot/.ssh/backup_ed25519

# Сколько дней хранить
KEEP_DAYS=30

# Проверка healthchecks.io для самого бэкапа. Пусто — выключено.
HC_URL=
