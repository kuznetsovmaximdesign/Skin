// Правила оформления Markdown (markdownlint-cli2). Необязателен:
// встроенная проверка в backend/checks/markdown.py покрывает то же самое.
{
  "default": true,
  "MD003": { "style": "atx" },          // заголовки только через #
  "MD004": { "style": "dash" },         // маркер списка — дефис
  "MD013": { "line_length": 120, "code_blocks": false, "tables": false },
  "MD024": { "siblings_only": true },   // одинаковые заголовки только в разных ветках
  "MD025": true,                         // один заголовок первого уровня
  "MD029": { "style": "ordered" },      // нумерация 1. 2. 3.
  "MD040": true,                         // у блоков кода указан язык
  "MD041": true,                         // документ начинается с заголовка первого уровня
  "MD046": { "style": "fenced" },
  "MD048": { "style": "backtick" }
}
